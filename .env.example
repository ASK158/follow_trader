# 用于保护 /api/cron/sync-signals 的随机长密钥。
CRON_SECRET=replace-with-a-long-random-secret

# NOWPayments Custody：仅服务端使用。生产回调必须是公网 HTTPS 地址。
# 在 NOWPayments 后台启用 Custody，将 Primary balance 设为 USDTTRC20，并保持提现地址/IP 白名单与 2FA 开启。
NOWPAYMENTS_API_KEY=replace-with-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=replace-with-nowpayments-ipn-secret
NOWPAYMENTS_IPN_CALLBACK_URL=https://signal.example.com/api/payments/nowpayments/ipn

# 可选：服务器无法直连外部 API 时配置 HTTP CONNECT 代理。代理必须能从容器访问，不能填写服务器外部设备的 127.0.0.1。
# HTTPS_PROXY=http://proxy-user:proxy-password@proxy.example.com:8080
# HTTP_PROXY=http://proxy-user:proxy-password@proxy.example.com:8080

# 生产环境 HTTPS 域名及用于 Let's Encrypt 通知的邮箱。
DOMAIN=signal.example.com
ACME_EMAIL=ops@example.com

# 可选：仅在 MQL5 导出 CSV 需要登录时设置。仅保存服务器环境变量，不要提交到仓库。
# MQL5_SESSION_COOKIE=key=value; another=value

# MT5 策略 Agent：官方 DeepSeek 服务端配置。所有用户共用此配置，浏览器不可提交或读取密钥。
# 不要使用 NEXT_PUBLIC_ 前缀，也不要把真实密钥提交到仓库。
AI_API_KEY=replace-with-your-server-side-api-key
AI_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-chat

# 账户安全。生产环境必须设置固定的 32 字节密钥（64 个十六进制字符）。
# 更换 AUTH_ENCRYPTION_KEY 会导致已启用的 TOTP 密钥无法解密。
AUTH_ENCRYPTION_KEY=
AUTH_AUDIT_PEPPER=
AUTH_RATE_LIMIT_PEPPER=

# 仅临时 IP/HTTP 公测使用。生产环境默认只在 HTTPS 下发送会话 Cookie；配置为 false
# 会让登录密码和会话面临被窃听风险，切换到 HTTPS 后必须删除此项或改为 true。
# AUTH_COOKIE_SECURE=false

# 正式配置邮件验证后，才显式设为 true 开放公开注册。
# PUBLIC_REGISTRATION_ENABLED=true

# 账户验证和密码重置邮件。SMTP 与 Webhook 二选一；生产环境至少配置一种。
# QQ 邮箱示例：登录 mail.qq.com 开启 SMTP 服务，SMTP_PASS 填“授权码”，不要填邮箱登录密码。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@qq.com
# SMTP_PASS=replace-with-email-authorization-code
# SMTP_FROM="Sigma Signal <your-account@qq.com>"

# 可选替代方案：账户邮件网关，接收 JSON：{ to, template, actionUrl }。
# EMAIL_WEBHOOK_URL=https://mail-gateway.example.com/send
# EMAIL_WEBHOOK_TOKEN=replace-with-webhook-bearer-token

# 可选：仅本机 Windows 开发环境的 MetaEditor 编译验证路径。
# 留空时默认使用 C:\Program Files\MetaTrader 5\MetaEditor64.exe。
# MQL5_METAEDITOR_PATH=C:\Program Files\MetaTrader 5\MetaEditor64.exe

# 仅兼容旧数据库第一次升级时的管理员迁移；新部署请使用 npm run admin:promote。
# MARKETPLACE_ADMIN_EMAILS=legacy-admin@example.com
