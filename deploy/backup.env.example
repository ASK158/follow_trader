# IP 源码部署使用此 Compose 文件；域名 HTTPS 部署请改为 docker-compose.production.yml。
COMPOSE_FILE=docker-compose.ip.yml

# rclone 已配置的远端目录。建议使用 rclone crypt 加密远端，且存储桶必须为私有。
# 计划使用的阿里云 OSS Bucket：sigmabot（创建时仍需确认名称可用）。
RCLONE_REMOTE=aliyun-oss:sigmabot/signal-web

# 本机保留天数；远端保留周期请在 OSS 生命周期策略中配置。
LOCAL_RETENTION_DAYS=14